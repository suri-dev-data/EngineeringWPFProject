<Window x:Class="EngineeringApplication.UControlAnalysisGraph"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EngineeringApplication"
        mc:Ignorable="d"
        Title="AnalysisGraph" Height="450" Width="800">

    <Grid Margin="35,35,35,35" >

        <Border Background="White" CornerRadius="20" Margin="0,25" BorderThickness="2,2,3,2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.05"/>
            </Border.Effect>

            <Grid Margin="20">
                <TextBlock Text="Analysis Result" FontSize="26" FontWeight="SemiBold"/>

                <TextBlock Text="Curve" FontWeight="Medium" Margin="0,40,0,0"/>

                <Canvas VerticalAlignment="Bottom" Height="200" Margin="10">
                    
                    <Path Opacity="0" Stroke="Transparent">
                        <Path.Data>
                            <PathGeometry Figures="M 0,180 C 100,180 150,50 250,80 C 350,110 450,20 600,50 L 600,200 L 0,200 Z"/>
                        </Path.Data>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Path.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0.2" 
                                                         Duration="0:0:3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <Path Fill="Transparent" StrokeThickness="4" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeDashArray="1000">
                        <Path.Data>
                            <PathGeometry Figures="M 0,180 C 100,180 150,50 250,80 C 350,110 450,20 600,50"/>
                        </Path.Data>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Path.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                     From="1000" To="0" 
                                     Duration="0:0:5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Canvas>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3"/>
    </Grid>
</Window>
