<UserControl x:Class="EngineeringApplication.UControlLoadingStepsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EngineeringApplication"
             mc:Ignorable="d" 
             x:Name="Root">

    <Grid MinWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Row="0" Margin="20,0,20,0">
            <ItemsControl VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Items>
                    <Label Content="Create Load Cases"  Grid.Column="0" FontStyle="Italic" FontFamily="Poppins" Width="Auto" Height="Auto" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0"/>
                    <Label Content="Create Data" Grid.Column="0" FontStyle="Italic" FontFamily="Poppins"  Width="Auto" Height="Auto" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-20,0" />
                    <Label Content="Create Structure" Grid.Column="1" FontStyle="Italic" FontFamily="Poppins"  Width="Auto" Height="Auto" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-20,0" />
                    <Label Content="Run Analysis" Grid.Column="2" FontStyle="Italic" FontFamily="Poppins" Width="Auto" Height="Auto" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0"/>
                </ItemsControl.Items>
            </ItemsControl>
        </Grid>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Row="1" Margin="20,0,20,0">
            <ProgressBar Name="MyProgressBar" 
                 Value="0" 
                 Maximum="100" 
                 Height="10" 
                 VerticalAlignment="Center"/>

            <ItemsControl VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Items>
                    <Ellipse Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"/>

                    <Ellipse Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,-10,0"/>

                    <Ellipse Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,-10,0"/>

                    <Ellipse Grid.Column="2" Width="20" Height="20" Fill="Black" Stroke="White" HorizontalAlignment="Right"/>
                </ItemsControl.Items>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
