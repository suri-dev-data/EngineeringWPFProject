<UserControl x:Class="EngineeringApplication.UControlProjRefVerticalOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EngineeringApplication"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="HorizontalDrawer"
                BorderThickness="0,0,0,0" 
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="32" Height="410" Margin="0,5,0,0" Grid.RowSpan="2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="DrawerHeader"  
                        BorderThickness="1,1,1,1"
                        Cursor="Hand"
                        MouseLeftButtonDown="DrawerHeader_MouseLeftButtonDown">

                    <Grid>
                        <Button x:Name="BtnToggle" 
                        Content="▶" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Top" 
                        Width="20" 
                        Height="20" 
                        Margin="0,5,0,0"
                        Click="BtnToggle_Click"
                        FontSize="6"
                        Padding="0" />

                        <TextBlock Text="Select Project Design References" 
                                   FontSize="11" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,0">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="1" x:Name="DrawerContentHolder" Padding="10" Opacity="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="Select Project Design References" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>

                        <DataGrid Grid.Row="1" 
                          x:Name="DataGridSensores"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          RowHeaderWidth="0">

                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sel." Width="35" 
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                <DataGridTextColumn Header="Ref" Width="120" 
                                    Binding="{Binding Ref}" 
                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Design" Width="120" 
                                Binding="{Binding Design}" 
                                IsReadOnly="True"/>
                                
                                <DataGridTextColumn Header="Description" Width="300" 
                                    Binding="{Binding Description}" 
                                    IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
