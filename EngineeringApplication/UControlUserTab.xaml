<UserControl x:Class="EngineeringApplication.UControlUserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EngineeringApplication"
             mc:Ignorable="d" 
             d:MinHeight="500" d:MinWidth="100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Width="80" Height="80" HorizontalAlignment="Center">
                <Ellipse.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Ellipse Width="80" Height="80" Fill="Black"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
            <TextBlock Text="User" FontWeight="Bold" FontSize="16" Margin="0,15,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Button Content="Database" Tag="" Margin="0,5"/>
            <Button Content="Report"  Tag="" Margin="0,5"/>
            <Button Content="Analysis"  Tag="" Margin="0,5"/>
            <Button Content="Project"  Tag="" Margin="0,5"/>
            <Button Content="Change Style" Tag="" Margin="0,5" Click="ChangeStyleButton_Click"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Exit" Tag="" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
