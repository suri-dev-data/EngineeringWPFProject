<Window x:Class="EngineeringApplication.WindowApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EngineeringApplication"
        mc:Ignorable="d"
        Title="Engineering Application" Height="480" Width="1300" 
        ResizeMode="NoResize"
        Topmost="True">

    <Grid>

        <Border 
            BorderThickness="1,1,1,1"  Margin="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Width="200" Height="410"
                    BorderThickness="1,1,1,1" VerticalAlignment="Top" 
                    HorizontalAlignment="Left" Margin="5,5,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Project Details" 
                                   FontWeight="Bold"  
                                   TextAlignment="Center" FontSize="20"/>

                            <Label Content="Project Code:" Margin="0,20,0,0"/>
                            <TextBox Text="PROJ-2026-X" Margin="0,0,0,2"/>

                            <Label Content="Project Name:" />
                            <TextBox AcceptsReturn="True" 
                            Height="80" 
                            VerticalContentAlignment="Top" 
                            TextWrapping="Wrap"
                            Text="Random Project Name"/>

                            <Label Content="Operator:" />
                            <Border BorderThickness="1">
                                <ComboBox x:Name="ComboOperador" 
                                    Margin="0" 
                                    SelectedIndex="0"
                                    Height="22" 
                                    BorderThickness="0">

                                    <ComboBoxItem Content="Vinícius"/>
                                    <ComboBoxItem Content="Takey"/>
                                    <ComboBoxItem Content="Julia"/>
                                </ComboBox>
                            </Border>

                            <Label Content="Buyer:"/>
                            <TextBox Text="Vinícius" Margin="0,0,0,2"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" 
                    BorderThickness="0,0,0,0" VerticalAlignment="Top" 
                    HorizontalAlignment="Left" >
                    <StackPanel>
                        <local:UControlVerticalOptions x:Name="LocalVerticalOptions" CloseOtherVerticalOptions="ACloseB" />
                    </StackPanel>
                </Border>
                <Border  Grid.Row="0" Grid.Column="2"
                    BorderThickness="0,0,0,0" VerticalAlignment="Top" 
                    HorizontalAlignment="Left"  >
                    <StackPanel>
                        <local:UControlProjRefVerticalOptions x:Name="LocalPRVerticalOptions" CloseOtherVerticalOptions="BCloseA" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="3"
                    Height="360"
                    BorderThickness="1,1,1,1" VerticalAlignment="Top" 
                    HorizontalAlignment="Left" Margin="0,5,5,5" >
                    <WrapPanel x:Name="PainelDeModulos3" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0"/>
                </Border>
                <Button x:Name="ChangeStyleButton" Grid.Column="3" Grid.Row="1" Content="Change Style" Width="100" Height="25" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,10,10" Click="ChangeStyleButton_Click" Style="{StaticResource RoundToggleButtonStyle}"/>
                <Button x:Name="SubmitButton" Grid.Column="3" Grid.Row="1" Content="Run Generic Analysis" Width="200" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Click="OpenAnalysis" Style="{StaticResource RoundToggleButtonStyle}"/>
            </Grid>
        </Border> 
    </Grid>

</Window>
